# Copie para .env (que NÃO é versionado) e troque os valores:
#   cp .env.example .env
# O docker compose lê o .env automaticamente.

# --- PostgreSQL (container) ---
POSTGRES_USER=edu_sync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=edu_sync

# --- Portas publicadas no host ---
# 5433 (e não 5432) para não colidir com um PostgreSQL já instalado na máquina.
POSTGRES_PORT=5433
SYNC_SERVICE_PORT=8000
MOCK_ACADEMICO_PORT=8001
MOCK_PROVEDOR_PORT=8002

LOG_LEVEL=INFO

# --- Retry do sync-service (valores padrão; todos opcionais) ---
# RETRY_MAX_ATTEMPTS=5          # tentativas totais, contando a primeira
# RETRY_BASE_DELAY_SECONDS=0.5  # atraso base do backoff exponencial
# RETRY_FACTOR=2
# RETRY_MAX_DELAY_SECONDS=30
# RETRY_JITTER=full             # full | none
# RETRY_MAX_ELAPSED_SECONDS=120 # orçamento de tempo por operação
# PROVIDER_CONCURRENCY=10       # chamadas simultâneas ao provedor
# SNAPSHOT_CONCURRENCY=5        # leituras simultâneas (páginas e membros por turma)
# PROVIDER_MAX_RPS=0            # máx. de requisições/s ao provedor (0 = sem limite)
# BATCH_SIZE=200                # ações por lote persistido
# MAX_CONSECUTIVE_FAILURES=25   # falhas seguidas (retries esgotados) até abortar o run

# --- Falhas do mock-provedor (para demonstrar a resiliência) ---
# PROVEDOR_CHAOS_ERROR_RATE=0.2          # chance de 5xx antes de processar
# PROVEDOR_CHAOS_LOSE_RESPONSE_RATE=0.1  # processa, mas a resposta se perde
# PROVEDOR_CHAOS_RETRY_AFTER_SECONDS=1
# PROVEDOR_CHAOS_RATE_LIMIT_RPS=0        # acima disso o mock responde 429
# PROVEDOR_CHAOS_LATENCY_MS=0            # latência artificial por requisição

# --- Tamanho do dataset do mock-academico ao subir (o benchmark usa 4000/90) ---
# SEED_STUDENTS=20
# SEED_CLASSES=3

# --- Só para rodar os testes de integração FORA do docker (pytest -m integration) ---
# Aponta para o PostgreSQL do compose publicado no host. Use o mesmo usuário/senha/porta acima.
TEST_DATABASE_URL=postgresql+asyncpg://edu_sync:change-me@localhost:5433/edu_sync
